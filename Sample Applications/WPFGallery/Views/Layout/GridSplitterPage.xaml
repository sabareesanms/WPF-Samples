<Page x:Class="WPFGallery.Views.Layout.GridSplitterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:WPFGallery.Controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFGallery.Views.Layout"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="GridSplitterPage">
    <Grid x:Name="ContentPagePane" Height="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding ViewModel.PageTitle}" AutomationProperties.HeadingLevel="Level1" />
            </StackPanel>

        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample
Margin="0"
HeaderText="Ribbon"
XamlCode="">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Ribbon x:Name="Ribbon" Title="Ribbon Title">
                            <Ribbon.ApplicationMenu>
                                <RibbonApplicationMenu>
                                    <RibbonApplicationMenuItem Header="New" />
                                    <RibbonApplicationMenuItem Header="Open" />
                                    <RibbonApplicationMenuItem Header="Save" />
                                </RibbonApplicationMenu>
                            </Ribbon.ApplicationMenu>
                            <RibbonTab Header="Home">
                                <RibbonGroup Header="Clipboard">
                                    <RibbonButton Label="Cut" />
                                    <RibbonButton Label="Copy" />
                                    <RibbonButton Label="Paste" />
                                </RibbonGroup>
                                <RibbonGroup Header="Font">
                                    <RibbonButton Label="Bold" />
                                    <RibbonButton Label="Italic" />
                                    <RibbonButton Label="Underline" />
                                </RibbonGroup>
                            </RibbonTab>
                            <RibbonTab Header="Insert">
                                <RibbonGroup Header="Text">
                                    <RibbonButton Label="Text Box" />
                                    <RibbonButton Label="Picture" />
                                </RibbonGroup>
                            </RibbonTab>
                        </Ribbon>
                    </Grid>
                </controls:ControlExample>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
